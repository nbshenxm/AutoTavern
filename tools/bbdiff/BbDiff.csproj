<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bob's Buddy (HDT's combat simulator) as a second opinion on TavernGym's combats
       (advisor.bb_diff). Built against the DLLs of the installed HDT, never copied here. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <HdtDir Condition="'$(HdtDir)' == ''">$(LOCALAPPDATA)\HearthstoneDeckTracker\app-1.59.6</HdtDir>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="BobsBuddy"><HintPath>$(HdtDir)\BobsBuddy.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BobsBuddy.Common"><HintPath>$(HdtDir)\BobsBuddy.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="HearthDb"><HintPath>$(HdtDir)\HearthDb.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(HdtDir)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
